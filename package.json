{
  "name": "email_worker",
  "version": "1.0.0",
  "description": "Mail stack with new_workers + new_server + new_frontend",
  "scripts": {
    "build": "npm run frontend:build",
    "dev": "./scripts/run-dev-stack.sh",
    "env:init": "node scripts/generate-env-secrets.mjs",
    "start": "./scripts/run-server-start.sh",
    "server:dev": "./scripts/run-server-dev.sh",
    "server:start": "./scripts/run-server-start.sh",
    "server:test": "node new_server/scripts/smoke-test.mjs",
    "server:openapi": "node new_server/scripts/validate-openapi.mjs",
    "frontend:dev": "./scripts/run-frontend-dev.sh",
    "frontend:build": "npm --prefix new_frontend run build",
    "frontend:lint": "npm --prefix new_frontend run lint",
    "worker:bundle": "esbuild new_workers/src/index.js --bundle --format=esm --platform=browser --outfile=/tmp/new-workers-bundle.js",
    "test": "npm run server:test && npm run server:openapi"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "html-to-text": "^9.0.5",
    "postal-mime": "^2.6.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "wrangler": "^4.55.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
